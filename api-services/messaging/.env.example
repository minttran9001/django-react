# Same Neon/Postgres connection string as api-services/backend/.env
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/mint-db?sslmode=require

# JWT_SECRET must match Django SECRET_KEY (simplejwt HS256).
# Quote the value — unquoted `#` is treated as a comment by dotenv.
JWT_SECRET='django-insecure-replace-me'

# Allowed CORS origin (Next.js)
FRONTEND_URL=http://localhost:3000

PORT=8001
