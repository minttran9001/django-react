generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuthUser {
  id                                                     Int                          @id @default(autoincrement())
  password                                               String                       @db.VarChar(128)
  lastLogin                                              DateTime?                    @map("last_login") @db.Timestamptz(6)
  isSuperuser                                            Boolean                      @map("is_superuser")
  username                                               String                       @unique @db.VarChar(150)
  firstName                                              String                       @map("first_name") @db.VarChar(150)
  lastName                                               String                       @map("last_name") @db.VarChar(150)
  email                                                  String                       @db.VarChar(254)
  isStaff                                                Boolean                      @map("is_staff")
  isActive                                               Boolean                      @map("is_active")
  dateJoined                                             DateTime                     @map("date_joined") @db.Timestamptz(6)
  api_booking                                            api_booking[]
  api_courtcenter                                        api_courtcenter[]
  api_emailverificationtoken                             api_emailverificationtoken[]
  api_image                                              Image[]
  members                                                Member[]                     @relation("MemberUser")
  messages                                               Message[]                    @relation("MessageSender")
  api_review                                             api_review[]
  api_transaction_api_transaction_customer_idToauth_user api_transaction[]            @relation("api_transaction_customer_idToauth_user")
  api_transaction_api_transaction_provider_idToauth_user api_transaction[]            @relation("api_transaction_provider_idToauth_user")
  profile                                                UserProfile?
  auth_user_groups                                       auth_user_groups[]
  auth_user_user_permissions                             auth_user_user_permissions[]
  django_admin_log                                       django_admin_log[]

  @@index([username], map: "auth_user_username_6821ab7c_like")
  @@map("auth_user")
}

model Image {
  id                  BigInt               @id @default(autoincrement())
  object_id           BigInt?
